dist/
deploy/one-hitter-lp.zip
deploy/.netlify-site.json

# サービスアカウントの鍵（絶対にコミットしない）
*-service-account*.json
*sa-key*.json
*.pem
credentials.json

# Python のキャッシュ
__pycache__/
*.pyc

# 一時作業ファイル（顧客の個人情報を含むためコミットしない）
scratch-*.json

# 顧客の電話番号を含む控え（リポジトリに置かない。控えは ~/.cache/one-hitter/backup/）
data/backup/*.json
# 下書きLPの確認用の書き出し（build-site.py --draft）。配信物ではない
preview/

# 広告リールの素材。写真は claude/web-inflow が持っている（この枝では複製を置かない）
#   git checkout origin/claude/web-inflow -- assets/photos
assets/photos/
# 描画用のフォント（OFL）。大きいので置かない。python3 tools/fetch-fonts.py で取る
assets/fonts/

# 現場で撮った動画の原本。大きいので置かない（READMEだけ追跡する）
assets/videos-raw/*
!assets/videos-raw/README.md
