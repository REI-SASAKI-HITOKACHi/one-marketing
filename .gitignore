dist/
deploy/one-hitter-lp.zip

# サービスアカウントの鍵（絶対にコミットしない）
*-service-account*.json
*sa-key*.json
*.pem
credentials.json

# Python のキャッシュ
__pycache__/
*.pyc

# 一時作業ファイル（顧客の個人情報を含むためコミットしない）
scratch-*.json

# 顧客の電話番号を含む控えは git に入れない（2026-09-11。~/.cache/one-hitter/backup/ に置く）
data/backup/*.json

# セーフブラウジング点検の前回時刻（実行時の状態。成果物ではない）
data/safebrowsing-last.json
data/kanryo-shashin/   # 作業完了フォームの施工写真（お客様宅）。git に入れない。元は Netlify のフォーム提出に残る（2026-09-27）
