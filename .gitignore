dist/
deploy/one-hitter-lp.zip
deploy/.netlify-site.json

# サービスアカウントの鍵（絶対にコミットしない）
*-service-account*.json
*sa-key*.json
*.pem
credentials.json

# Python のキャッシュ
__pycache__/
*.pyc

# 一時作業ファイル（顧客の個人情報を含むためコミットしない）
scratch-*.json

# 顧客の電話番号を含む控え（リポジトリに置かない。控えは ~/.cache/one-hitter/backup/）
data/backup/*.json
