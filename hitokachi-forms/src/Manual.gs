  }
];

/**
 * 「使い方」シートを作り直し、タブの先頭に置く。
 *
 * 既にあれば中身を全部消して書き直す。A 列に項目、B 列に説明の 2 列構成。
 * 章の行は太字・背景色付きで、本文は折り返して読めるよう列幅を広めに取る。
 *
 * @param {Spreadsheet} ss 設定スプレッドシート
 * @return {Sheet} 書き終えた「使い方」シート
 */
function ensureManualSheet_(ss) {
  var sh = ss.getSheetByName(SHEET_MANUAL) || ss.insertSheet(SHEET_MANUAL);
  sh.clear();

  var rows = [['項目', '説明']];
  var sectionRows = []; // 章の行番号（1 始まり）。あとで色を付ける
  MANUAL_SECTIONS_.forEach(function (sec) {
    rows.push([sec.title, '']);
    sectionRows.push(rows.length);
    sec.rows.forEach(function (r) { rows.push([r[0], r[1]]); });
  });

  var body = sh.getRange(1, 1, rows.length, 2);
  body.setValues(rows).setWrap(true).setVerticalAlignment('top');

  // 見出し行
  sh.getRange(1, 1, 1, 2).setFontWeight('bold').setBackground(MANUAL_HEADER_BG);
  sh.setFrozenRows(1);

  // 章の行。1 行まるごと色を付けて、どこから次の章かが一目で分かるようにする
  sectionRows.forEach(function (row) {
    sh.getRange(row, 1, 1, 2).setFontWeight('bold').setBackground(MANUAL_SECTION_BG);
  });

  // 項目の列は太字で、説明の列は広めに。折り返しで読めるようにする
  sh.getRange(2, 1, rows.length - 1, 1).setFontWeight('bold');
  sh.setColumnWidth(1, 240);
  sh.setColumnWidth(2, 760);

  // タブの先頭に置く。開いたときに最初に目に入るように
  ss.setActiveSheet(sh);
  ss.moveActiveSheet(1);

  return sh;
}
